-- Services
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

-- LocalPlayer
local LP = Players.LocalPlayer
local Mouse = LP:GetMouse()

-- UI Toggle Variables
local settings = {
    espPlayers = true,
    espZombies = true,
    espItems = false,
    aimbotPlayers = true,
    aimbotZombies = false,
    aimbotKey = Enum.KeyCode.F
}

-- UI Setup
local ScreenGui = Instance.new("ScreenGui", LP:WaitForChild("PlayerGui"))
ScreenGui.Name = "DeadzoneESP_UI"

local function createToggle(name, default, position, callback)
    local frame = Instance.new("Frame", ScreenGui)
    frame.Size = UDim2.new(0, 180, 0, 24)
    frame.Position = position
    frame.BackgroundColor3 = Color3.fromRGB(30,30,30)

    local button = Instance.new("TextButton", frame)
    button.Size = UDim2.new(1, 0, 1, 0)
    button.Text = name .. ": [" .. (default and "ON" or "OFF") .. "]"
    button.TextColor3 = Color3.new(1,1,1)
    button.BackgroundTransparency = 1

    button.MouseButton1Click:Connect(function()
        default = not default
        button.Text = name .. ": [" .. (default and "ON" or "OFF") .. "]"
        callback(default)
    end)
end

-- UI Toggles
createToggle("ESP Players", settings.espPlayers, UDim2.new(0,10,0,10), function(v) settings.espPlayers = v end)
createToggle("ESP Zombies", settings.espZombies, UDim2.new(0,10,0,40), function(v) settings.espZombies = v end)
createToggle("ESP Items", settings.espItems, UDim2.new(0,10,0,70), function(v) settings.espItems = v end)
createToggle("Aimbot Players", settings.aimbotPlayers, UDim2.new(0,10,0,100), function(v) settings.aimbotPlayers = v end)
createToggle("Aimbot Zombies", settings.aimbotZombies, UDim2.new(0,10,0,130), function(v) settings.aimbotZombies = v end)

-- Change Aimbot Key
local changeKeyBtn = Instance.new("TextButton", ScreenGui)
changeKeyBtn.Size = UDim2.new(0, 180, 0, 24)
changeKeyBtn.Position = UDim2.new(0, 10, 0, 160)
changeKeyBtn.Text = "Change Aimbot Key (F)"
changeKeyBtn.TextColor3 = Color3.new(1,1,1)
changeKeyBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)

changeKeyBtn.MouseButton1Click:Connect(function()
    changeKeyBtn.Text = "Press new key..."
    local conn
    conn = UserInputService.InputBegan:Connect(function(input, gpe)
        if not gpe then
            settings.aimbotKey = input.KeyCode
            changeKeyBtn.Text = "Change Aimbot Key (" .. input.KeyCode.Name .. ")"
            conn:Disconnect()
        end
    end)
end)

-- ESP Function
local function drawESP(obj, color)
    local box = Drawing.new("Text")
    box.Text = obj.Name
    box.Size = 14
    box.Center = true
    box.Outline = true
    box.Visible = true
    box.Color = color

    RunService.RenderStepped:Connect(function()
        if obj and obj:FindFirstChild("HumanoidRootPart") and box then
            local pos, onScreen = workspace.CurrentCamera:WorldToViewportPoint(obj.HumanoidRootPart.Position)
            box.Visible = onScreen
            if onScreen then
                box.Position = Vector2.new(pos.X, pos.Y)
            end
        else
            box.Visible = false
        end
    end)
end

-- Aimbot
local function getClosestTarget()
    local closest, shortest = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and settings.aimbotPlayers and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local dist = (workspace.CurrentCamera.CFrame.Position - p.Character.HumanoidRootPart.Position).Magnitude
            if dist < shortest then
                closest, shortest = p.Character.HumanoidRootPart, dist
            end
        end
    end
    if settings.aimbotZombies and workspace:FindFirstChild("Zombies") then
        for _, z in ipairs(workspace.Zombies:GetChildren()) do
            if z:FindFirstChild("HumanoidRootPart") then
                local dist = (workspace.CurrentCamera.CFrame.Position - z.HumanoidRootPart.Position).Magnitude
                if dist < shortest then
                    closest, shortest = z.HumanoidRootPart, dist
                end
            end
        end
    end
    return closest
end

UserInputService.InputBegan:Connect(function(input, gpe)
    if not gpe and input.KeyCode == settings.aimbotKey then
        local target = getClosestTarget()
        if target then
            workspace.CurrentCamera.CFrame = CFrame.new(workspace.CurrentCamera.CFrame.Position, target.Position)
        end
    end
end)

-- Start ESP
for _, p in ipairs(Players:GetPlayers()) do
    if p ~= LP and settings.espPlayers then
        drawESP(p.Character or p.CharacterAdded:Wait(), Color3.new(0,1,0))
    end
end

if workspace:FindFirstChild("Zombies") and settings.espZombies then
    for _, z in ipairs(workspace.Zombies:GetChildren()) do
        drawESP(z, Color3.new(1,0,0))
    end
end

if workspace:FindFirstChild("Items") and settings.espItems then
    for _, item in ipairs(workspace.Items:GetChildren()) do
        drawESP(item, Color3.new(1,1,0))
    end
end
