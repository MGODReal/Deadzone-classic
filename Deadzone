-- ฟังก์ชันในการคำนวณการยิงแบบ Silent Aim
local function calculateSilentAim(target)
    if not SilentAimEnabled or not target then return end
    
    local targetPos = target.HumanoidRootPart.Position
    local myPos = Camera.CFrame.Position
    local direction = (targetPos - myPos).unit  -- คำนวณทิศทางจากผู้เล่นไปยังเป้าหมาย
    
    -- กำหนดให้การยิงจะถูกเล็งไปที่ตำแหน่งของศัตรู
    Camera.CFrame = CFrame.lookAt(myPos, targetPos)
end

-- ฟังก์ชันแสดง ESP
local function createESP(target)
    if not ESPEnabled or not target or not target:FindFirstChild("HumanoidRootPart") then return end

    -- สร้าง ESP ให้กับตัวละครที่พบ
    local espBox = Instance.new("BillboardGui")
    espBox.Adornee = target.HumanoidRootPart
    espBox.Size = UDim2.new(0, 200, 0, 50)
    espBox.StudsOffset = Vector3.new(0, 3, 0)
    espBox.Parent = target.HumanoidRootPart
    
    local espText = Instance.new("TextLabel")
    espText.Size = UDim2.new(1, 0, 1, 0)
    espText.BackgroundTransparency = 1
    espText.TextColor3 = Color3.fromRGB(255, 255, 255)
    espText.TextStrokeTransparency = 0.8
    espText.Text = target.Name
    espText.Parent = espBox
end

-- ฟังก์ชันเลือกเป้าหมายที่อยู่ใน FOV และประเภทที่เลือก (ผู้เล่นหรือซอมบี้)
local function getTargetInFOV()
    local closestTarget = nil
    local shortestDistance = TargetDistance

    -- ค้นหาผู้เล่นหรือซอมบี้ในระยะ
    for _, target in pairs(Workspace:GetChildren()) do
        -- ตรวจสอบว่าเป็นผู้เล่น
        if TargetingOption == "Players" and target:IsA("Model") and target:FindFirstChild("HumanoidRootPart") then
            local player = Players:GetPlayerFromCharacter(target)
            if player then
                local distance = (Camera.CFrame.Position - target.HumanoidRootPart.Position).Magnitude
                if distance < shortestDistance then
                    closestTarget = target
                    shortestDistance = distance
                end
            end
        -- หรือถ้าเป็นซอมบี้
        elseif TargetingOption == "Zombies" and target:IsA("Model") and target:FindFirstChild("HumanoidRootPart") then
            -- เช็คซอมบี้ในเกม (ปรับตามลักษณะซอมบี้ในเกมของคุณ)
            local distance = (Camera.CFrame.Position - target.HumanoidRootPart.Position).Magnitude
            if distance < shortestDistance then
                closestTarget = target
                shortestDistance = distance
            end
        end
    end

    return closestTarget
end

-- ฟังก์ชันอัปเดต Aimbot และ Silent Aim
local function updateAimbotAndSilentAim()
    if AimbotEnabled then
        -- ค้นหาเป้าหมายใน FOV
        local target = getTargetInFOV()

        if target then
            -- ถ้าเปิด Silent Aim จะยิงไปที่ตำแหน่งของศัตรูโดยไม่ต้องเล็ง
            calculateSilentAim(target)
        end
    end
end

-- เรียกใช้งานฟังก์ชัน
game:GetService("RunService").Heartbeat:Connect(function()
    updateAimbotAndSilentAim()

    -- สร้าง ESP สำหรับผู้เล่นที่ใกล้
    for _, player in pairs(Players:GetPlayers()) do
        if player.Character then
            createESP(player.Character)
        end
    end
end)
