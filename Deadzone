local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- Settings
local settings = {
    espPlayers = true,
    espZombies = true,
    espItems = false,
    aimbotEnabled = false,
    silentAimEnabled = false,
    aimAt = "Players", -- "Players" or "Zombies"
    fov = 100,
}

-- UI Setup
local ScreenGui = Instance.new("ScreenGui", LocalPlayer:WaitForChild("PlayerGui"))
ScreenGui.Name = "DeadzoneHelperUI"

local function createToggle(name, default, position, callback)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(0, 200, 0, 30)
    button.Position = position
    button.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.Text = name .. ": " .. tostring(default)
    button.Parent = ScreenGui
    local state = default
    button.MouseButton1Click:Connect(function()
        state = not state
        button.Text = name .. ": " .. tostring(state)
        callback(state)
    end)
end

createToggle("ESP Players", settings.espPlayers, UDim2.new(0, 10, 0, 10), function(v) settings.espPlayers = v end)
createToggle("ESP Zombies", settings.espZombies, UDim2.new(0, 10, 0, 50), function(v) settings.espZombies = v end)
createToggle("ESP Items", settings.espItems, UDim2.new(0, 10, 0, 90), function(v) settings.espItems = v end)
createToggle("Aimbot", settings.aimbotEnabled, UDim2.new(0, 10, 0, 130), function(v) settings.aimbotEnabled = v end)
createToggle("Silent Aim", settings.silentAimEnabled, UDim2.new(0, 10, 0, 170), function(v) settings.silentAimEnabled = v end)

-- FOV Circle
local fovCircle = Drawing.new("Circle")
fovCircle.Visible = true
fovCircle.Color = Color3.fromRGB(0, 255, 0)
fovCircle.Thickness = 1
fovCircle.Radius = settings.fov
fovCircle.Filled = false

-- ESP
local function createESP(part, color)
    local box = Drawing.new("Text")
    box.Text = "ESP"
    box.Color = color
    box.Size = 14
    box.Center = true
    box.Outline = true
    box.Visible = true
    return function()
        if part and part:IsDescendantOf(workspace) and part:FindFirstChild("HumanoidRootPart") then
            local pos, onScreen = Camera:WorldToViewportPoint(part.HumanoidRootPart.Position)
            box.Visible = onScreen
            if onScreen then
                box.Position = Vector2.new(pos.X, pos.Y)
            end
        else
            box.Visible = false
        end
    end
end

local espHandlers = {}

RunService.RenderStepped:Connect(function()
    fovCircle.Position = UserInputService:GetMouseLocation()

    for _, handler in ipairs(espHandlers) do handler() end
end)

-- Target Finder
local function getClosestTarget()
    local targets = {}
    if settings.aimAt == "Players" then
        targets = Players:GetPlayers()
    elseif workspace:FindFirstChild("Zombies") then
        targets = workspace.Zombies:GetChildren()
    end

    local closest = nil
    local shortest = math.huge
    for _, target in ipairs(targets) do
        if target ~= LocalPlayer and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            local pos, onScreen = Camera:WorldToViewportPoint(target.Character.HumanoidRootPart.Position)
            if onScreen then
                local dist = (UserInputService:GetMouseLocation() - Vector2.new(pos.X, pos.Y)).Magnitude
                if dist < shortest and dist <= settings.fov then
                    shortest = dist
                    closest = target
                end
            end
        end
    end
    return closest
end

-- Silent Aim Hook Example
local __namecall
__namecall = hookmetamethod(game, "__namecall", function(self, ...)
    local args = {...}
    local method = getnamecallmethod()

    if settings.silentAimEnabled and tostring(self) == "Raycast" and method == "InvokeServer" then
        local target = getClosestTarget()
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            -- Modify the ray origin/direction here if needed
            -- args[1] = modified
            -- args[2] = modified
            return __namecall(self, unpack(args))
        end
    end

    return __namecall(self, ...)
end)

-- Initial ESP Setup
local function setupESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and settings.espPlayers then
            table.insert(espHandlers, createESP(player.Character, Color3.fromRGB(255, 255, 0)))
        end
    end

    if workspace:FindFirstChild("Zombies") and settings.espZombies then
        for _, zombie in ipairs(workspace.Zombies:GetChildren()) do
            table.insert(espHandlers, createESP(zombie, Color3.fromRGB(255, 0, 0)))
        end
    end
end

Players.PlayerAdded:Connect(setupESP)
setupESP()
